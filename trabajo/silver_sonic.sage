from Crypto.Random import random
from Crypto.Util.number import getPrime, long_to_bytes, bytes_to_long




flag = b'ictf{REDACTED}'
F.<y> = GF(2^128)

poly_coefficients = [random.getrandbits(1) * F.random_element() for i in range(128)]

def apply_poly(a):
    return sum(poly_coefficients[i] * a^(2^i) for i in range(128))
    

a = F.random_element()


b = []

for i in range(512):
    a = apply_poly(a)
    b.append(a.polynomial().coefficients(sparse=False)[0])

c = int(''.join(str(i) for i in b),2)

p = 
q = 


print(int(pow(q,c,p)) ^^ int(bytes_to_long(flag)))
print(b[:256])

